LLM_PROVIDER=ollama
OLLAMA_PROFILE=development
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0
OLLAMA_KEEP_ALIVE=30m
PLANNER_ATTEMPT_TIMEOUT_SECONDS=1200
PLANNER_TOTAL_TIMEOUT_SECONDS=3600
PLANNER_OLLAMA_STOP_GRACE_SECONDS=90
PLANNER_OLLAMA_STOP_POLL_SECONDS=5
PLANNER_OPERATION_CATALOG_MODE=full
PLANNER_FEW_SHOT_MODE=off
# Set to full to restore all 64 expanded operation descriptions.
# OLLAMA_EXECUTABLE=D:\Ollama\ollama.exe

# Profiles for this computer (32 GB RAM, RTX 5060 Laptop 8 GB):
# lightweight -> qwen3:8b,  4096 context (deployment)
# development -> qwen3:14b, 4096 context (default)
# validation  -> qwen3:32b, 2048 context (slow quality comparison)
# OLLAMA_MODEL and OLLAMA_NUM_CTX may optionally override the selected profile.
# Bound reasoning plus final-answer generation so context shifting cannot loop.
OLLAMA_NUM_PREDICT=4096

# Optional legacy backend:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
